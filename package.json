{
  "name": "iotroam",
  "version": "1.0.2",
  "description": "A TypeScript-first, dependency-free API client for the SURF IoTroam REST API",
  "main": "./dist/index.es.js",
  "module": "./dist/index.es.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.es.js",
      "require": "./dist/index.cjs.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc && vite build",
    "preview": "vite preview",
    "test": "vitest",
    "test:ui": "vitest --ui",
    "examples/groups": "tsx --env-file=.env examples/groups.ts",
    "examples/group/devices": "tsx --env-file=.env examples/group.devices.ts",
    "examples/device/add": "tsx --env-file=.env examples/device.add.ts",
    "examples/device/delete": "tsx --env-file=.env examples/device.delete.ts",
    "examples/device/edit": "tsx --env-file=.env examples/device.edit.ts",
    "examples/device/get": "tsx --env-file=.env examples/device.get.ts",
    "test:coverage": "vitest run --coverage",
    "docs:build": "typedoc src/index.ts --out generated/docs --name \"iotroam\" --theme default --excludePrivate --excludeProtected"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/DataLab-Rotterdam/iotroam.git"
  },
  "keywords": [
    "iotroam",
    "surf",
    "nl",
    "eduroam"
  ],
  "author": "A.P.A. Slaa",
  "license": "Apache-2.0",
  "type": "module",
  "bugs": {
    "url": "https://github.com/DataLab-Rotterdam/iotroam/issues"
  },
  "homepage": "datalab-rotterdam.github.io/iotroam/",
  "publishConfig": {
    "access": "public"
  },
  "devDependencies": {
    "@semantic-release/changelog": "^6.0.3",
    "@semantic-release/commit-analyzer": "^13.0.1",
    "@semantic-release/git": "^10.0.1",
    "@semantic-release/npm": "^13.1.3",
    "@semantic-release/release-notes-generator": "^14.1.0",
    "@types/node": "^25.0.9",
    "@vitest/coverage-v8": "^4.0.17",
    "@vitest/ui": "^4.0.17",
    "tsx": "^4.20.4",
    "typedoc": "^0.28.16",
    "typescript": "^5.9.3",
    "vite": "^7.3.1",
    "vite-plugin-dts": "^4.5.4",
    "vitest": "^4.0.17"
  },
  "release": {
    "branches": [
      "main"
    ],
    "plugins": [
      "@semantic-release/commit-analyzer",
      "@semantic-release/release-notes-generator",
      "@semantic-release/changelog",
      "@semantic-release/npm",
      [
        "@semantic-release/git",
        {
          "assets": [
            "package.json",
            "CHANGELOG.md"
          ],
          "message": "iotroam(release): 🚀 ${nextRelease.version} \n\n${nextRelease.notes}"
        }
      ]
    ]
  }
}
